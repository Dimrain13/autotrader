[Unit]
Description=MomentumX Trading Frontend (static build via `serve`)
After=network.target momentumx-backend.service

[Service]
Type=simple
User=momentumx
Environment=HOME=/tmp
WorkingDirectory=/opt/momentumx/frontend
ExecStart=/usr/bin/serve -s build -l tcp://127.0.0.1:4000
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
